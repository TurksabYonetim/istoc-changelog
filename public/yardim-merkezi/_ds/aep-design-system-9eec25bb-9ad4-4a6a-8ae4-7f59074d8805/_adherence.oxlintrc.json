{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ai/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/primitives/**",
              "ui_kits/commerce-pdp/**",
              "ui_kits/ea-console/**",
              "ui_kits/ebm-report/**",
              "ui_kits/ebp-dashboard/**",
              "ui_kits/eop-exceptions/**",
              "ui_kits/erx-config/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Noto Sans))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Noto Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentStatusIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|agent|onCancel|key|ref|className|style|children)$/]",
        "message": "<AgentStatusIndicator> doesn't accept that prop. Declared props: state, agent, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentStatusIndicator'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|working|waiting|error)$/]",
        "message": "<AgentStatusIndicator> state must be one of 'idle' | 'working' | 'waiting' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIAuditLogRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:agent|action|input|output|approvedBy|time|key|ref|className|style|children)$/]",
        "message": "<AIAuditLogRow> doesn't accept that prop. Declared props: agent, action, input, output, approvedBy, time."
      },
